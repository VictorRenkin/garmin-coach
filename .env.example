# Facultatif. Si ces champs restent vides, l'application les demande au clavier.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Intervalle de surveillance en secondes (300 = 5 minutes).
GARMIN_POLL_SECONDS=300

# Clé créée sur https://platform.openai.com/api-keys
# Ne partage jamais cette valeur et ne versionne jamais le fichier .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Compte Motionest et envoi des e-mails. En local, les messages sont déposés
# dans data/outbox. En production, HTTPS et un serveur SMTP sont obligatoires.
MOTIONEST_ENV=development
MOTIONEST_PUBLIC_URL=http://127.0.0.1:8765
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Motionest <no-reply@motionest.app>

# Cloudflare Turnstile. Ces clés deviennent obligatoires en production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
